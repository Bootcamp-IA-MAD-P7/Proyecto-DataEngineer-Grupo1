# External Kafka supplied by the educational project. Do not commit .env.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=
KAFKA_CONSUMER_GROUP=hr-pro-platform

# Local services; values will be enabled when their Jira tasks are implemented.
MONGODB_URI=mongodb://mongo:27017/hr_pro
POSTGRES_DB=hr_pro
POSTGRES_USER=hr_pro
POSTGRES_PASSWORD=change-me-locally
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
