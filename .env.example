# External Kafka supplied by the educational project. Do not commit .env.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPICS=
KAFKA_CONSUMER_GROUP=hr-pro-platform

# Local development services. The MongoDB Compose service binds only to localhost.
MONGODB_URI=mongodb://localhost:27017/hr_pro
MONGODB_DB=hr_pro
MONGODB_COLLECTION=raw_events
MONGODB_INVALID_COLLECTION=invalid_events
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hr_pro
POSTGRES_USER=hr_pro
POSTGRES_PASSWORD=change-me-locally
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
